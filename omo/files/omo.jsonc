// OMO configuration
//
// 서브에이전트(task) 실행 차단 — 2026-09-17.
// 실제 차단은 ~/.omo/agent/settings.json 의 "permission" 블록이 한다.
//   { "task": "deny", "task_*": "deny", "workpool": "deny" }
// 세션 시작 시 위 도구들이 활성 목록에서 제거된다(새 세션부터 적용).
// 다시 켜려면 settings.json 의 "permission" 블록을 지운다.
//   백업: settings.json.bak.20260917-subagent-block
//   (task.global_concurrency: 0 은 차단이 아니라 무제한이다 — 쓰지 말 것)
//
// 아래 categories/agents 의 model 핀은 지우지 말 것.
// 자식(카테고리·에이전트)은 세션 모델을 상속하지 않는다. 해석 순서는
//   1) omo.json 핀  2) 내장 체인  3) 연결된 프로바이더가 서빙하는 첫 러그
// 이므로 핀을 지우면 자식이 내장 체인의 아무 모델로나 떨어진다.
{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",
  // Shared-base categories: visible to every harness (senpi task engine included).
  // [opencode].categories below still wins for the OpenCode harness per-key.
  "categories": {
    "memory-reflection": { "model": "opencodex/bai/deepseek-v4.1-flash" },
    "quick":             { "model": "opencodex/command-code/deepseek-deepseek-v4.1-flash", "reasoning": "medium" },
    "unspecified-low":    { "model": "opencodex/command-code/deepseek-deepseek-v4.1-flash", "reasoning": "medium" },
    // command-code 라인에는 deepseek-v4-pro가 없어서, pro급 작업은 승인된 gpt-5.6-terra로 라우팅.
    "deep-low":          { "model": "openai-codex/gpt-5.6-terra",                      "reasoning": "high" },
    "unspecified-high":   { "model": "opencodex/xai/grok-4.6",                  "reasoning": "high" },
    // opencode-go 라인은 게이트웨이 카탈로그에서 제거됨 (2026-09-16 확인) — combo 라인으로 교체.
    "writing":           { "model": "opencodex/combo/glm-5.3-flash",         "reasoning": "medium" },
    "artistry":          { "model": "opencodex/xai/grok-4.6",                  "reasoning": "high" },
    "visual-engineering": { "model": "opencodex/xai/grok-4.6",                  "reasoning": "high" },
    // reflection 전용: opencodex/bai/deepseek-v4.1-flash 고정 (2026-09-21 지정).
    // fork 모드 자식은 부모 세션 전체를 물고 뜨므로, 272K 컨텍스트의 gpt-5.6-luna는
    // RequiredCompactionError(child_exit)로 죽었다. bai는 950K라 그 자리를 견딘다.
    // bai/deepseek-v4.1-flash는 비추론 모델이라 reasoning 키를 두지 않는다.
    "reflection":        { "model": "opencodex/bai/deepseek-v4.1-flash" },
    // kakaotalk-mcp 실행 전용: 사용자가 지정한 구현 실행기 (2026-09-15).
    // 작업 성격(quick/deep 등)은 프롬프트가 정하고, 모델은 이 카테고리가 고정한다.
    "devin-max":         { "model": "opencodex/devin/swe-2", "reasoning": "max" },
    // ultrabrain: 공유 베이스 고정 (2026-09-16 지정). [opencode] 블록은 senpi가 읽지 않으므로 senpi용은 여기서 고정.
    "ultrabrain":        { "model": "openai-codex/gpt-5.6-terra",            "reasoning": "max" },
    // architect: 공유 베이스 고정 (2026-09-16 지정). anthropic/claude 계열은 현재 인증 없음 → openai-codex로 고정.
    "architect":         { "model": "openai-codex/gpt-5.6-terra",            "reasoning": "high" }
  },
  // 내장 서브에이전트 모델 고정 (2026-09-16 지정). senpi task 엔진은 공유 베이스 agents만 읽는다.
  // explore/librarian은 현재 내장 체인 1순위와 동일하지만, 체인 변동·폴백 미끄러짐 방지로 명시한다.
  "agents": {
    "explore":         { "model": "openai-codex/gpt-5.6-luna-fast", "reasoning": "low" },
    "librarian":       { "model": "openai-codex/gpt-5.6-luna-fast", "reasoning": "low" },
    "plan-consultant": { "model": "openai-codex/gpt-5.6-terra",     "reasoning": "high" },
    "plan-reviewer":   { "model": "openai-codex/gpt-5.6-terra",     "reasoning": "high" }
  },
  // memory reflection 실행 카테고리.
  "memory": {
    "reflection": { "category": "reflection" }
  },
  "[opencode]": {
    "codegraph": {},
    "agents": {
      "sisyphus": {
        "model": "openai/gpt-5.6-terra",
        "reasoning": "xhigh"
      },
      "hephaestus": {
        "model": "command-code/deepseek/deepseek-v4-pro",
        "reasoning": "high"
      },
      "oracle": {
        "model": "openai/gpt-5.6-terra",
        "reasoning": "high"
      },
      "explore": {
        "model": "command-code/deepseek/deepseek-v4-flash",
        "reasoning": "medium"
      },
      "multimodal-looker": {
        "model": "command-code/google/gemini-3.7-flash",
        "reasoning": "medium"
      },
      "prometheus": {
        "model": "openai/gpt-5.6-terra",
        "reasoning": "xhigh"
      },
      "metis": {
        "model": "openai/gpt-5.6-terra",
        "reasoning": "xhigh"
      },
      "momus": {
        "model": "command-code/deepseek/deepseek-v4-flash",
        "reasoning": "medium"
      },
      "atlas": {
        "model": "openai/gpt-5.6-terra",
        "reasoning": "medium"
      },
      "sisyphus-junior": {
        "model": "openai/gpt-5.6-terra",
        "reasoning": "medium"
      },
      "librarian": {
        "model": "openai/gpt-5.6-terra",
        "reasoning": "medium"
      },
      "frontend-ui-ux-engineer": {
        "model": "command-code/meta/muse-spark-1.2",
        "reasoning": "high"
      },
      "document-writer": {
        "model": "command-code/meta/muse-spark-1.2-contributor",
        "reasoning": "medium"
      }
    },
    // ultrabrain만 하네스별 유지; 나머지 카테고리는 공용 베이스(위)의 opencodex 매핑을 따른다.
    "categories": {
      "ultrabrain": {
        "model": "openai/gpt-5.6-sol",
        "reasoning": "xhigh"
      }
    },
    "skills": {
      "sources": [
        {
          "path": "/Users/alpox/.gstack/repos/gstack/.opencode/skills",
          "recursive": true
        }
      ],
