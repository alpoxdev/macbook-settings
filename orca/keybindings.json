{
  "version": 1,
  "keybindings": {
    "tab.selectByIndex": [
      "Mod+1"
    ],
    "workspace.selectByIndex": [
      "Alt+1"
    ]
  },
  "platforms": {
    "darwin": {
      "tab.nextSameType": [
        "Mod+Shift+BracketRight"
      ],
      "tab.previousSameType": [
        "Mod+Shift+BracketLeft"
      ],
      "tab.nextAllTypes": [
        "Mod+Alt+BracketRight"
      ],
      "tab.previousAllTypes": [
        "Mod+Alt+BracketLeft"
      ],
      "workspace.create": [],
      "workspace.rename": [],
      "terminal.setTitle": [
        "Mod+N"
      ],
      "terminal.clearPaneTitle": [
        "Mod+Shift+N"
      ]
    },
    "linux": {},
    "win32": {}
  }
}
