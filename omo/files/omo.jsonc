// OMO configuration
//
// 서브에이전트 모델 고정 — 2026-09-21 (A안).
// 모든 카테고리·에이전트를 opencodex/bai/deepseek-v4.1-flash 로 고정한다.
// 자식(카테고리·에이전트)은 세션 모델을 상속하지 않으므로, 핀을 지우면 내장 체인의
// 아무 모델로나 떨어진다. 해석 순서는
//   1) 호출자가 넘긴 model 인자  2) agents.<n> 핀(가용성 검증 있음)
//   3) categories.<n> 핀(검증 없음, 가장 강함)  4) 내장 체인  5) 시스템 기본 모델
// 이므로 자식에게 model 인자를 직접 넘기면 이 핀을 이긴다. 규칙: ~/.omo/rules/subagent.md
//
// 2026-09-17 의 차단(permission deny)은 제거했다.
//   되돌리려면 settings.json.bak.20260917-subagent-block 참고.
//   (task.global_concurrency: 0 은 차단이 아니라 무제한이다 — 쓰지 말 것)
{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",
  // Shared-base categories: visible to every harness (senpi task engine included).
  // [opencode].categories below still wins for the OpenCode harness per-key.
  // 전부 opencodex/bai/deepseek-v4.1-flash 고정 (2026-09-21). bai는 비추론 모델이라
  // reasoning/variant 키를 두지 않는다.
  "categories": {
    "visual-engineering": { "model": "opencodex/bai/deepseek-v4.1-flash" },
    "artistry":           { "model": "opencodex/bai/deepseek-v4.1-flash" },
    "deep-low":           { "model": "opencodex/bai/deepseek-v4.1-flash" },
    "deep-high":          { "model": "opencodex/bai/deepseek-v4.1-flash" },
    "quick":              { "model": "opencodex/bai/deepseek-v4.1-flash" },
    "unspecified-low":    { "model": "opencodex/bai/deepseek-v4.1-flash" },
    "unspecified-high":   { "model": "opencodex/bai/deepseek-v4.1-flash" },
    "writing":            { "model": "opencodex/bai/deepseek-v4.1-flash" },
    // omo 자체 카테고리.
    "memory-reflection":  { "model": "opencodex/bai/deepseek-v4.1-flash" },
    "reflection":         { "model": "opencodex/bai/deepseek-v4.1-flash" },
    // kakaotalk-mcp 실행 전용이었으나 2026-09-21 전면 고정에 따라 같은 모델로 통일.
    // devin/swe-2 로 되돌리려면 이 줄만 고치면 된다.
    "devin-max":          { "model": "opencodex/bai/deepseek-v4.1-flash" },
    // 고난도 카테고리 2종은 호출 자체를 막는다(2026-09-21 사용자 지정).
    // 호출하면 category_disabled 오류가 난다.
    "ultrabrain":         { "disable": true },
    "architect":          { "disable": true }
  },
  // 내장 서브에이전트 모델 고정. senpi task 엔진은 공유 베이스 agents만 읽는다.
  // 에이전트 핀은 세션 가용 목록 검증을 거치므로, 불가하면 아래 categories 핀으로 떨어진다.
  "agents": {
    "explore":                  { "model": "opencodex/bai/deepseek-v4.1-flash" },
    "librarian":                { "model": "opencodex/bai/deepseek-v4.1-flash" },
    "plan-consultant":          { "model": "opencodex/bai/deepseek-v4.1-flash" },
    "plan-reviewer":            { "model": "opencodex/bai/deepseek-v4.1-flash" },
    "omo-senpi-code-reviewer":  { "model": "opencodex/bai/deepseek-v4.1-flash" },
    "omo-senpi-gate-reviewer":  { "model": "opencodex/bai/deepseek-v4.1-flash" },
    "omo-senpi-qa-executor":    { "model": "opencodex/bai/deepseek-v4.1-flash" }
  },
  // memory reflection 실행 카테고리.
  "memory": {
    "reflection": { "category": "reflection" }
  },
  "[opencode]": {
    "codegraph": {},
    "agents": {
      "sisyphus": {
        "model": "openai/gpt-5.6-terra",
        "reasoning": "xhigh"
      },
      "hephaestus": {
        "model": "command-code/deepseek/deepseek-v4-pro",
        "reasoning": "high"
      },
      "oracle": {
        "model": "openai/gpt-5.6-terra",
        "reasoning": "high"
      },
      "explore": {
        "model": "command-code/deepseek/deepseek-v4-flash",
        "reasoning": "medium"
      },
      "multimodal-looker": {
        "model": "command-code/google/gemini-3.7-flash",
        "reasoning": "medium"
      },
      "prometheus": {
        "model": "openai/gpt-5.6-terra",
        "reasoning": "xhigh"
      },
      "metis": {
        "model": "openai/gpt-5.6-terra",
        "reasoning": "xhigh"
      },
      "momus": {
        "model": "command-code/deepseek/deepseek-v4-flash",
        "reasoning": "medium"
      },
      "atlas": {
        "model": "openai/gpt-5.6-terra",
        "reasoning": "medium"
      },
      "sisyphus-junior": {
        "model": "openai/gpt-5.6-terra",
        "reasoning": "medium"
      },
      "librarian": {
        "model": "openai/gpt-5.6-terra",
        "reasoning": "medium"
      },
      "frontend-ui-ux-engineer": {
        "model": "command-code/meta/muse-spark-1.2",
        "reasoning": "high"
      },
      "document-writer": {
        "model": "command-code/meta/muse-spark-1.2-contributor",
        "reasoning": "medium"
      }
    },
    // ultrabrain만 하네스별 유지; 나머지 카테고리는 공용 베이스(위)의 opencodex 매핑을 따른다.
    "categories": {
      "ultrabrain": {
        "model": "openai/gpt-5.6-sol",
        "reasoning": "xhigh"
      }
    },
    "skills": {
      "sources": [
        {
          "path": "/Users/alpox/.gstack/repos/gstack/.opencode/skills",
          "recursive": true
        }
      ],
